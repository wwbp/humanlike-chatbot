# -----------------------------------------------------------------------------
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in every value.
# NEVER commit terraform.tfvars to git — it contains secrets.
#
# How to generate the Django secret key:
#   cd generic_chatbot
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# -----------------------------------------------------------------------------

# Which environment am I deploying?
# Allowed values: "staging" or "production"
environment = "staging"

# The AWS region where I deploy everything.
# All resources (EB, RDS, ElastiCache, S3, CloudFront) land here.
aws_region = "us-east-1"

# A short name that prefixes every AWS resource I create.
# Changing this after first deploy would recreate everything, so pick once and keep it.
project_name = "humanlike-chatbot"

# -----------------------------------------------------------------------
# Secrets — fill these in, never share this file
# -----------------------------------------------------------------------

# OpenAI API key — used by the Django backend for chat and moderation
openai_api_key = "sk-proj-..."

# Anthropic API key — used for Claude-based chat models
anthropic_api_key = "sk-ant-..."

# Password for the MariaDB database user I create on RDS.
# Rules: at least 8 characters, letters and numbers only (no special chars —
# some chars break the MySQL connection string).
db_password = "REPLACE_with_strong_password_min8chars"

# Django's cryptographic signing key.
# Rules: must be at least 50 characters. Generate one with the command above.
django_secret_key = "REPLACE_with_output_of_get_random_secret_key_command"

# -----------------------------------------------------------------------
# GitHub — used to create an IAM role that GitHub Actions can assume
# via OIDC (no long-lived AWS access keys stored in GitHub secrets)
# -----------------------------------------------------------------------

# The GitHub organization or username that owns this repository
github_org = "wwbp"

# The repository name (without the org prefix)
github_repo = "chatbotlab"

# -----------------------------------------------------------------------
# Instance sizing — safe to leave as defaults for staging
# -----------------------------------------------------------------------

# EC2 instance type for the Elastic Beanstalk application servers
eb_instance_type = "t3.small"

# RDS instance class for the MariaDB database
db_instance_class = "db.t3.micro"
