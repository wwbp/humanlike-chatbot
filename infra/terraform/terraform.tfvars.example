# -----------------------------------------------------------------------------
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in every value marked REQUIRED.
# NEVER commit terraform.tfvars to git — it contains secrets.
#
# If you are deploying via the GitHub Actions workflow (recommended), you do
# not need this file at all — secrets are passed through GitHub repository
# secrets instead.
# -----------------------------------------------------------------------------

# Which environment am I deploying?
# Allowed values: "staging" or "production"
environment = "production"

# The AWS region where I deploy everything.
aws_region = "us-east-1"

# A short name that prefixes every AWS resource I create.
# Changing this after first deploy recreates everything, so pick once and keep it.
project_name = "humanlike-chatbot"

# -----------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------

# OpenAI API key — used for chat and content moderation.
# At least one of openai_api_key or anthropic_api_key must be set.
openai_api_key = "sk-proj-..."

# Anthropic API key — used for Claude-based chat models.
# Leave as empty string if using OpenAI only: anthropic_api_key = ""
anthropic_api_key = "sk-ant-..."

# Password for the MariaDB database.
# Letters and numbers only — special characters can break the connection string.
db_password = "REPLACE_with_strong_password"

# Password for the Django admin panel at /api/admin/.
# You will use this every time you log in to configure the chatbot.
admin_panel_password = "REPLACE_with_admin_password"

# -----------------------------------------------------------------------
# Django secret key (optional — auto-generated if left empty)
# -----------------------------------------------------------------------

# Leave empty to let Terraform generate and manage a stable key automatically.
# Only set this if you need to use a specific key (e.g. migrating an existing
# deployment). Must be at least 50 characters if provided.
django_secret_key = ""

# -----------------------------------------------------------------------
# GitHub — used to create an IAM role that GitHub Actions can assume
# via OIDC (no long-lived AWS access keys stored in GitHub secrets)
# -----------------------------------------------------------------------

github_org  = "your-github-username-or-org"
github_repo = "humanlike-chatbot"

# -----------------------------------------------------------------------
# Custom domain (optional)
# -----------------------------------------------------------------------

# Leave empty to use the auto-assigned CloudFront URL (https://xxxx.cloudfront.net).
# Set to your domain (e.g. chatbot.mylab.org) to serve from a custom URL.
# If set, you will need to add a DNS validation record at your registrar.
domain_name = ""

# -----------------------------------------------------------------------
# Instance sizing — safe to leave as defaults for most studies
# -----------------------------------------------------------------------

# EC2 instance type for the app server
eb_instance_type = "t3.small"

# Maximum number of app server instances under load
eb_max_instances = 1

# RDS instance class for the MariaDB database
db_instance_class = "db.t3.micro"
