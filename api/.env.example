# Django admin superuser (used by `make superuser` locally; set in EB env vars for deployed environments)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme

# Django
DEBUG=True
SECRET_KEY=your_django_secret_key_here_min_50_chars
BACKEND_ENVIRONMENT=local

# Database (Django connection)
DATABASE_NAME=chatbot_db
DATABASE_USER=your_mysql_user
DATABASE_PASSWORD=your_mysql_password
DATABASE_HOST=db
DATABASE_PORT=3306

# MariaDB container (used by docker compose db service)
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=chatbot_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_URL=redis://redis:6379

# LLM API keys (at least one required)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Optional: allow a custom frontend origin (e.g. for embedded deployments)
# FRONTEND_URL=https://your-frontend-domain.com

# Optional: AWS S3 (for avatar/voice file storage — required in production)
# AWS_BUCKET_NAME=your_aws_bucket_name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# App
CHATBOT_CONTROL_IMAGE=https://example.com/control-image.png
CHATBOT_AVATAR_PROMPT=Create a professional avatar for a chatbot
